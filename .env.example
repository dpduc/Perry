# Copy to .env and fill in. Never put real values in this file.

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# LangSmith tracing (optional): https://smith.langchain.com -> Settings -> API Keys
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://apac.api.smith.langchain.com
LANGCHAIN_API_KEY=

# Optional overrides
# PERRY_LLM_MODEL=gemini-3.8-flash
# PERRY_EMBEDDING_MODEL=gemini-embedding-001
# PERRY_REQUESTS_PER_SECOND=0.0667  (4/min; free tier allows 5/min)
# DATABASE_URL=postgresql://perry:perry@127.0.0.1:5433/perry

# Usage limits
# PERRY_TURN_TOKEN_CEILING=50000  (a Turn stops and reports its findings past this)
# PERRY_PRICES_FILE=prices.toml  (USD per million tokens, per model)
# PERRY_DAILY_CAP_USD=1.00  (new Turns and ingestion are refused past this until local midnight)

# Google (Task Agent). Both files live outside the repo; see README "Connecting Google".
# PERRY_APP_DATA_DIR=   (default %APPDATA%\Perry; holds google_token.json)
# PERRY_GOOGLE_CLIENT_FILE=   (default <app-data>\google_client.json)
